---
// Each home scene pairs one real product screenshot with its botanical
// photograph. The full screenshot galleries live on the product pages.
import type { HomeSection, Lang } from '../lib/languages';
import { Picture } from 'astro:assets';
import { CAPTIONS, SCREENS } from '../data/screens';
import { PRODUCT_ARTWORK } from '../data/botanical';
import BotanicalVisual from './BotanicalVisual.astro';

interface Props {
  section: HomeSection;
  lang: Lang;
}

const { section, lang } = Astro.props;
const project = section === 'teaching' ? 'tipitaka' : section;
const screenshot = { teaching: 1, search: 1, viz: 0, learn: 2 }[section];
---

<div class="stage">
  <div class="stage__glow" aria-hidden="true"></div>
  <div class="reader-stage" data-project={project}>
    <BotanicalVisual kind={PRODUCT_ARTWORK[project]} />
    <div class="reader-stage__phone">
      <Picture
        src={SCREENS[project][screenshot]}
        formats={['avif', 'webp']}
        widths={[554]}
        sizes="440px"
        alt={CAPTIONS[project][lang][screenshot]}
        loading="lazy"
      />
    </div>
  </div>
</div>
