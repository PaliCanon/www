---
// The bar: the lotus and name link home at the left, the language toggle at
// the right; no page links (each home scene leads to its page). Every page
// but the home starts the bar with a round back link, a chevron to the
// language's home (user check 14): a plain link, no history.back, so it
// works with no JavaScript and from a page opened directly. The bar
// sits clear on the page's deep card at the top and turns to glass once the
// page scrolls (chrome.css); story.ts hides it while scrolling down.
import { Picture } from 'astro:assets';
import lotus from '../assets/lotus.png';
import type { Lang } from '../lib/languages';
import { STRINGS } from '../lib/strings';
import { pagePath } from '../lib/url';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
  lang: Lang;
  pageKey: string;
  available: Lang[];
  /** Show the back link to the language's home (every page but the home). */
  back?: boolean;
}

const { lang, pageKey, available, back = false } = Astro.props;
---

<header class="site-header">
  <div class="bar">
    {back && (
      <a href={pagePath(lang, 'index')} class="back">
        <span class="sr-only">{STRINGS[lang].back}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M15 5l-7 7 7 7" />
        </svg>
      </a>
    )}
    <a href={pagePath(lang, 'index')} aria-label={STRINGS[lang].home} class="brand">
      <Picture
        src={lotus}
        formats={['avif', 'webp']}
        densities={[1, 2]}
        width={28}
        height={28}
        alt=""
        class="brand__lotus"
        loading="eager"
      />
      <span class="brand__name">PaliCanon</span>
    </a>
    <LanguageSwitch lang={lang} pageKey={pageKey} available={available} />
  </div>
</header>
