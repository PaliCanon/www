---
// The footer: the PALICANON wordmark and the legal notice, under a thin
// line; centred on a phone, in one row from md up.
import type { Lang } from '../lib/languages';
import { STRINGS } from '../lib/strings';
import { pagePath } from '../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__brand">PaliCanon</p>
    <a href={pagePath(lang, 'legal')} class="site-footer__legal">
      {STRINGS[lang].legal}
    </a>
  </div>
</footer>
