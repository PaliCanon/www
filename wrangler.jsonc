// Cloudflare Workers static assets, no Worker script: dist/ is all a Worker
// receives, 404.html answers an unknown path, a page is served at its
// trailing-slash address. One Worker per environment, always deployed with
// `--env` (deploy.yml): wrangler owns www-dev and www-prod, tofu (infra/)
// owns only their custom domains, so no route is declared here. No
// workers.dev address and no preview URL: the custom domain is the only way in.
{
  "name": "www",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "dev": { "name": "www-dev" },
    "prod": { "name": "www-prod" },
  },
}
