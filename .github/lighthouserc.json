{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/fr/",
        "http://localhost:4173/tipitaka/",
        "http://localhost:4173/blog/welcome/"
      ],
      "numberOfRuns": 1,
      "startServerCommand": "npx --yes serve@14.2.6 dist-lh --listen 4173 --no-clipboard",
      "startServerReadyPattern": "Accepting connections",
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:performance": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lhci-reports" }
  }
}
